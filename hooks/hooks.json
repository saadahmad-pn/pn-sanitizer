{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "$CURSOR_PLUGIN_ROOT/scripts/check-prompt.py",
        "matcher": "",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "$CURSOR_PLUGIN_ROOT/scripts/check-write.py",
        "matcher": "Write",
        "failClosed": true,
        "timeout": 20
      }
    ]
  }
}
