{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "scripts/run-hook.cmd check-session",
        "matcher": "",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "scripts/run-hook.cmd check-session-end",
        "matcher": "",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "scripts/run-hook.cmd check-turn-complete",
        "matcher": "",
        "failClosed": false,
        "timeout": 15
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "scripts/run-hook.cmd check-prompt",
        "timeout": 250,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "matcher": "",
        "command": "scripts/run-hook.cmd check-tool-call",
        "timeout": 250,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "matcher": "",
        "command": "scripts/run-hook.cmd check-tool-call-record",
        "failClosed": false,
        "timeout": 15
      }
    ],
    "beforeShellExecution": [
      {
        "matcher": "\\bgit\\s+push\\b",
        "command": "scripts/run-hook.cmd check-git-event git.push",
        "timeout": 240,
        "failClosed": true
      },
      {
        "matcher": "\\bgit\\s+commit\\b",
        "command": "scripts/run-hook.cmd check-git-event git.commit",
        "timeout": 240,
        "failClosed": true
      },
      {
        "matcher": "\\bgh\\s+pr\\s+create\\b",
        "command": "scripts/run-hook.cmd check-git-event git.pr_create",
        "timeout": 240,
        "failClosed": true
      }
    ],
    "afterShellExecution": [
      {
        "matcher": "",
        "command": "scripts/run-hook.cmd check-git-event-record",
        "timeout": 15,
        "failClosed": false
      }
    ]
  }
}
