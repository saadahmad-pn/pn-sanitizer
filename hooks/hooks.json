{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./scripts/check-session.py",
        "matcher": "",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./scripts/check-prompt.py",
        "matcher": "",
        "failClosed": true,
        "timeout": 10
      }
    ]
  }
}
