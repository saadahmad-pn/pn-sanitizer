{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash ./scripts/check-session.sh",
        "matcher": "",
        "failClosed": false,
        "timeout": 10
      },
      {
        "command": "./scripts/run-powershell.cmd ./scripts/check-session.ps1",
        "matcher": "",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "bash ./scripts/check-prompt.sh",
        "timeout": 25
      },
      {
        "command": "./scripts/run-powershell.cmd ./scripts/check-prompt.ps1",
        "timeout": 45
      },
      {
        "command": "bash ./scripts/check-repo-context.sh",
        "timeout": 10
      },
      {
        "command": "./scripts/run-powershell.cmd ./scripts/check-repo-context.ps1",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "matcher": "Write",
        "command": "bash ./scripts/check-write.sh",
        "timeout": 25
      },
      {
        "matcher": "Write",
        "command": "./scripts/run-powershell.cmd ./scripts/check-write.ps1",
        "timeout": 45
      }
    ]
  }
}
