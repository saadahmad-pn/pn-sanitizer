{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "python ${CURSOR_PLUGIN_ROOT}/scripts/check-prompt.py",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "matcher": "Write|Edit",
        "command": "python ${CURSOR_PLUGIN_ROOT}/scripts/check-write.py",
        "timeout": 20
      }
    ]
  }
}
