{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "scripts/run-hook.cmd check-session",
        "matcher": "",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "scripts/run-hook.cmd check-prompt",
        "timeout": 250,
        "failClosed": true
      },
      {
        "command": "scripts/run-hook.cmd check-repo-context",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "matcher": "Write",
        "command": "bash ./scripts/check-write.sh",
        "timeout": 250
      },
      {
        "matcher": "Write",
        "command": "./scripts/run-powershell.cmd ./scripts/check-write.ps1",
        "timeout": 250
      },
      {
        "matcher": "",
        "command": "bash ./scripts/spike-skill-detection.sh",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "matcher": "",
        "command": "bash ./scripts/spike-skill-detection.sh",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "matcher": "^\\s*git\\s+push\\b",
        "command": "scripts/run-hook.cmd check-git-event git.push",
        "timeout": 240,
        "failClosed": true
      },
      {
        "matcher": "^\\s*git\\s+commit\\b",
        "command": "scripts/run-hook.cmd check-git-event git.commit",
        "timeout": 240,
        "failClosed": true
      },
      {
        "matcher": "^\\s*gh\\s+pr\\s+create\\b",
        "command": "scripts/run-hook.cmd check-git-event git.pr_create",
        "timeout": 240,
        "failClosed": true
      }
    ]
  }
}
