{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash ./scripts/check-session.sh",
        "matcher": "",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "bash ./scripts/check-prompt.sh",
        "timeout": 25
      }
    ],
    "preToolUse": [
      {
        "matcher": "Write",
        "command": "bash ./scripts/check-write.sh",
        "timeout": 25
      }
    ]
  }
}
