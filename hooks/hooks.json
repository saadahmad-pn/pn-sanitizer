{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "scripts/run-hook.cmd check-session",
        "matcher": "",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "scripts/run-hook.cmd check-prompt",
        "timeout": 250,
        "failClosed": true
      },
      {
        "command": "scripts/run-hook.cmd check-repo-context",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "matcher": "Write",
        "command": "scripts/run-hook.cmd check-write",
        "timeout": 250,
        "failClosed": true
      },
      {
        "matcher": "",
        "command": "bash ./scripts/spike-skill-detection.sh",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "matcher": "",
        "command": "bash ./scripts/spike-skill-detection.sh",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "afterShellExecution": [
      {
        "matcher": "",
        "command": "scripts/run-hook.cmd debug-capture-payload",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "matcher": "",
        "command": "scripts/run-hook.cmd debug-capture-payload",
        "failClosed": false,
        "timeout": 10
      }
    ]
  }
}
